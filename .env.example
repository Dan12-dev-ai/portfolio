# ---------------------------------------------------------------------------
# Daniel Degu — portfolio environment
#
# Copy to `.env.local` and fill in the values you want to override. Every key
# is optional: the app ships with working defaults so `npm run dev` works with
# no environment at all.
# ---------------------------------------------------------------------------

# Canonical origin used for sitemap/canonical/OG URLs.
# Production example: https://danieldegu.dev
NEXT_PUBLIC_SITE_URL=

# Platform destinations (defaults are the live Daniel Degu accounts).
LINKEDIN_URL=https://www.linkedin.com/in/daniel-degu-0a086b3b3
GITHUB_URL=https://github.com/Dan12-dev-ai
X_URL=https://x.com/DeguDaniel14592
TELEGRAM_URL=https://t.me/DDDan21

# Inbox address shown as the email contact and used for reply links.
CONTACT_EMAIL=danieldegu909@gmail.com

# Token for /admin and every admin API (GET/PATCH/DELETE /api/messages,
# GET /api/subscribers, GET /api/clicks). CHANGE THIS IN PRODUCTION.
ADMIN_TOKEN=daniel-degu-admin

# Where the JSON data store (messages, subscribers, clicks) is written.
# Falls back to `data/` inside the project, then to the OS temp directory.
PORTFOLIO_DATA_DIR=
